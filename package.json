{
  "name": "@lutejka/nuxt-otel",
  "version": "0.1.6",
  "description": "OpenTelemetry tracing for Nuxt applications",
  "keywords": [
    "monitoring",
    "observability",
    "openTelemetry",
    "otel",
    "nuxt"
  ],
  "homepage": "https://github.com/lutejka/nuxt-otel#readme",
  "bugs": {
    "url": "https://github.com/lutejka/nuxt-otel/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lutejka/nuxt-otel.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build && pnpm client:build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:preview": "nuxt preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nuxt/devtools-kit": "^3.2.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "h3": "^1.15.11",
    "sirv": "^3.0.2",
    "ufo": "^1.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.35.2",
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/devtools-ui-kit": "^3.3.1",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@types/body-parser": "^1.19.6",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.4.1",
    "nuxt": "^4.5.1",
    "oxfmt": "^0.56.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
