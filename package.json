{
  "name": "@lutejka/nuxt-otel",
  "version": "0.4.1",
  "description": "OpenTelemetry tracing for Nuxt applications",
  "keywords": [
    "monitoring",
    "nuxt",
    "observability",
    "openTelemetry",
    "otel"
  ],
  "homepage": "https://lutejka.github.io/nuxt-otel/",
  "bugs": {
    "url": "https://github.com/lutejka/nuxt-otel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lutejka/nuxt-otel.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "module:build": "nuxt-module-build prepare && nuxt-module-build build",
    "docs:prepare": "nuxt-module-build prepare",
    "build": "pnpm module:build",
    "prepack": "pnpm build",
    "docs:build": "pnpm --filter nuxt-otel-docs build",
    "docs:dev": "pnpm --filter nuxt-otel-docs dev",
    "docs:generate": "pnpm --filter nuxt-otel-docs generate",
    "dev": "pnpm dev:nuxt4",
    "dev:nuxt4": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playgrounds/nuxt4 && nuxt dev playgrounds/nuxt4",
    "dev:nuxt5": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playgrounds/nuxt5 && nuxt dev playgrounds/nuxt5",
    "dev:build": "nuxt build playgrounds/nuxt4",
    "dev:preview": "nuxt preview playgrounds/nuxt4",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playgrounds/nuxt4",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playgrounds/nuxt4 && vue-tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "devframe": "^1.2.6",
    "h3": "^1.15.11",
    "ufo": "^1.6.4",
    "vite-opentelemetry-inspector": "0.1.0"
  },
  "devDependencies": {
    "@devframes/agentic": "^1.2.6",
    "@nuxt/cli": "^4.0.1",
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@types/node": "^26.6.5",
    "dprint": "^0.64.3",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
