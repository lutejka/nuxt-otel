{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "~~": ["../client"],
      "~~/*": ["../client/*"],
      "~": ["../client/app"],
      "~/*": ["../client/app/*"],
      "~shared": ["../shared"],
      "~shared/*": ["../shared/*"]
    }
  }
}
